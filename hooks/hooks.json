{
  "description": "자동 검증 루프: .py 저장 시 문법을 검사하고, 문법 오류가 있으면 Claude에게 전달",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/verify-on-edit.ps1\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
